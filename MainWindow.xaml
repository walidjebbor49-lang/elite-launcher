<Window x:Class="ELITE.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ELITE Launcher" Height="650" Width="1000"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        FontFamily="Segoe UI"
        Background="{DynamicResource BgBrush}">

    <Window.Resources>

        <!-- ═════════ COLORES (el código los cambia para tema claro/oscuro y acento) ═════════ -->
        <Color x:Key="BgColor">#0B0D14</Color>
        <Color x:Key="SidebarColor">#11141D</Color>
        <Color x:Key="CardColor">#171B28</Color>
        <Color x:Key="InputColor">#1F2435</Color>
        <Color x:Key="LineColor">#2A3045</Color>
        <Color x:Key="TextColor">#FFFFFF</Color>
        <Color x:Key="MutedColor">#8B9BB4</Color>
        <Color x:Key="NavActiveColor">#1F2435</Color>
        <Color x:Key="AccentColor">#7C5CFF</Color>
        <Color x:Key="AccentColor2">#5B3FE0</Color>

        <SolidColorBrush x:Key="BgBrush" Color="{DynamicResource BgColor}"/>
        <SolidColorBrush x:Key="SidebarBrush" Color="{DynamicResource SidebarColor}"/>
        <SolidColorBrush x:Key="CardBrush" Color="{DynamicResource CardColor}"/>
        <SolidColorBrush x:Key="InputBrush" Color="{DynamicResource InputColor}"/>
        <SolidColorBrush x:Key="LineBrush" Color="{DynamicResource LineColor}"/>
        <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}"/>
        <SolidColorBrush x:Key="MutedBrush" Color="{DynamicResource MutedColor}"/>
        <SolidColorBrush x:Key="NavActiveBrush" Color="{DynamicResource NavActiveColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}"/>

        <!-- ═════════ TEXTOS ═════════ -->
        <Style x:Key="Eyebrow" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="H1" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- ═════════ TARJETA ═════════ -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="24"/>
        </Style>

        <!-- ═════════ BOTONES ═════════ -->
        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="#E5484D"/>
        </Style>
        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="#10B981"/>
        </Style>

        <!-- Botón del menú lateral (Tag="Active" marca la página actual) -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10"/>
                            <Border x:Name="Bar" Width="3" Height="18" CornerRadius="2"
                                    Background="{DynamicResource AccentBrush}"
                                    HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"/>
                            <ContentPresenter Margin="18,11" VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavActiveBrush}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavActiveBrush}"/>
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═════════ CAJA DE TEXTO ═════════ -->
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═════════ LISTA ═════════ -->
        <Style x:Key="DarkList" TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="4">
                            <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavActiveBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═════════ DESPLEGABLE ═════════ -->
        <Style x:Key="ComboToggle" TargetType="ToggleButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{DynamicResource InputBrush}"
                                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8">
                            <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"
                                  Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.6"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Style="{StaticResource ComboToggle}" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter IsHitTestVisible="False" Margin="14,0,34,0"
                                              VerticalAlignment="Center" HorizontalAlignment="Left"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                            <Popup Placement="Bottom" Focusable="False" AllowsTransparency="True"
                                   PopupAnimation="Fade" IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border MinWidth="{Binding Path=ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}"
                                        BorderThickness="1" CornerRadius="8" Margin="0,4,0,0" Padding="4">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavActiveBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═════════ INTERRUPTOR (CheckBox) ═════════ -->
        <Style x:Key="SwitchBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="42" Height="22" VerticalAlignment="Center">
                                <Border x:Name="Track" CornerRadius="11" Background="{DynamicResource InputBrush}"
                                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"/>
                                <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="{DynamicResource MutedBrush}"
                                         HorizontalAlignment="Left" Margin="3,0,0,0"/>
                            </Grid>
                            <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═════════ BARRA LATERAL ═════════ -->
        <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,0,1,0" Grid.Column="0">
            <DockPanel Margin="20">
                <StackPanel Orientation="Horizontal" Margin="0,4,0,30" DockPanel.Dock="Top">
                    <Border Width="40" Height="40" CornerRadius="12">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
                                <GradientStop Color="{DynamicResource AccentColor2}" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="E" Foreground="White" FontWeight="Bold" FontSize="20"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="LblBrandTitle" Text="ELITE" Foreground="{DynamicResource TextBrush}" FontWeight="Bold" FontSize="17"/>
                        <TextBlock x:Name="LblBrandSub" Text="MINECRAFT LAUNCHER" Foreground="{DynamicResource MutedBrush}" FontSize="9" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock x:Name="LblMenuHeader" Text="MENÚ PRINCIPAL" Foreground="{DynamicResource MutedBrush}"
                           FontSize="10" FontWeight="Bold" Margin="6,0,0,10" DockPanel.Dock="Top"/>

                <!-- Jugador registrado -->
                <Border Style="{StaticResource Card}" Padding="14,12" CornerRadius="12" DockPanel.Dock="Bottom">
                    <StackPanel>
                        <TextBlock x:Name="LblSidebarUserTag" Text="JUGADOR" Foreground="{DynamicResource MutedBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,3"/>
                        <TextBlock x:Name="TxtSidebarUser" Text="Sin registrar" Foreground="{DynamicResource TextBrush}" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <StackPanel>
                    <Button x:Name="BtnNavRegister" Content="Registro" Click="NavRegister_Click" Style="{StaticResource NavButton}" Tag="Active"/>
                    <Button x:Name="BtnNavHome" Content="Inicio" Click="NavHome_Click" Style="{StaticResource NavButton}"/>
                    <Button x:Name="BtnNavOpt" Content="Optimización" Click="Optimization_Click" Style="{StaticResource NavButton}"/>
                    <Button x:Name="BtnNavMods" Content="Mods" Click="Mods_Click" Style="{StaticResource NavButton}"/>
                    <Button x:Name="BtnNavSettings" Content="Ajustes" Click="Settings_Click" Style="{StaticResource NavButton}"/>
                    <Button x:Name="BtnNavAdmin" Content="Admin" Click="NavAdmin_Click" Style="{StaticResource NavButton}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═════════ CONTENIDO ═════════ -->
        <Grid Grid.Column="1" Margin="40">

            <!-- INICIO -->
            <StackPanel x:Name="ViewHome" VerticalAlignment="Center" Visibility="Visible">
                <Border CornerRadius="16" Padding="30,28" Margin="0,0,0,20">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
                            <GradientStop Color="{DynamicResource AccentColor2}" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <TextBlock x:Name="LblWelcomeTag" Text="BIENVENIDO A ELITE" Foreground="White" Opacity="0.8" FontSize="12" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock x:Name="LblWelcomeMain" Text="Tu Minecraft. A tu manera." Foreground="White" FontSize="30" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock x:Name="LblWelcomeDesc" Text="Selecciona tu versión de Forge preferida y entra al servidor." Foreground="White" Opacity="0.85" FontSize="14" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                                <TextBlock x:Name="LblSelectVersion" Text="Selecciona la Versión de Forge" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CbVersions" Style="{StaticResource DarkCombo}" Width="260" HorizontalAlignment="Left" SelectedIndex="0">
                                    <ComboBoxItem Content="Forge 1.20.1"/>
                                </ComboBox>
                            </StackPanel>
                            <Button x:Name="BtnLaunch" Grid.Column="1" Content="JUGAR ►" Click="BtnLaunch_Click"
                                    Style="{StaticResource PrimaryButton}" Width="190" Height="46" FontSize="15" VerticalAlignment="Bottom"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Ellipse x:Name="ElServerDot" Width="9" Height="9" Fill="#8B9BB4" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtServerStatus" Text="" Style="{StaticResource Muted}" FontSize="12" Margin="8,0,0,0"/>
                            <TextBlock x:Name="TxtHomePlayer" Text="" Style="{StaticResource Muted}" FontSize="12" Margin="16,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Anuncios del organizador (se leen de announcement.txt en el repo) -->
                <Border x:Name="BdNews" Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,18" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="LblNewsTitle" Text="Anuncios del evento" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock x:Name="TxtNews" Text="" Foreground="{DynamicResource TextBrush}" FontSize="13" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <ProgressBar x:Name="PbLaunch" IsIndeterminate="True" Height="4" Visibility="Collapsed" BorderThickness="0"
                             Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource InputBrush}" Margin="0,0,0,10"/>
                <TextBlock x:Name="TxtStatus" Text="  Sistema listo" Foreground="#00B894" FontSize="12" FontWeight="Bold" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- REGISTRO (obligatorio) -->
            <StackPanel x:Name="ViewRegister" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock x:Name="LblRegTag" Text="REGISTRO OBLIGATORIO" Style="{StaticResource Eyebrow}"/>
                <TextBlock x:Name="LblRegTitle" Text="Regístrate" Style="{StaticResource H1}"/>
                <TextBlock x:Name="LblRegDesc" Text="Escribe el nombre de jugador con el que te invitaron al evento." Style="{StaticResource Muted}" Margin="0,0,0,26"/>

                <Border Style="{StaticResource Card}" Padding="28" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock x:Name="LblRegName" Text="Nombre de jugador" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtRegName" Style="{StaticResource InputBox}" Height="40" Width="300" HorizontalAlignment="Left"
                                 MaxLength="16" Margin="0,0,0,20" PreviewKeyDown="TxtRegName_KeyDown"/>
                        <Button x:Name="BtnRegister" Content="REGISTRARME" Click="BtnRegister_Click"
                                Style="{StaticResource PrimaryButton}" Width="190" Height="44" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="TxtRegCurrent" Text="Sin registrar" Foreground="{DynamicResource TextBrush}" FontSize="13" FontWeight="Bold" Margin="4,0,0,6"/>
                <TextBlock x:Name="TxtRegStatus" Text="" Foreground="{DynamicResource MutedBrush}" FontSize="12" FontWeight="Bold" TextWrapping="Wrap" Margin="4,0,0,0"/>
            </StackPanel>

            <!-- PANEL DE ADMINISTRADOR -->
            <ScrollViewer x:Name="ViewAdmin" VerticalAlignment="Center" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock x:Name="LblAdminTag" Text="PANEL DE ADMINISTRADOR" Style="{StaticResource Eyebrow}"/>
                    <TextBlock x:Name="LblAdminTitle" Text="Participantes invitados" Style="{StaticResource H1}"/>
                    <TextBlock x:Name="LblAdminDesc" Text="Solo los nombres de esta lista podrán registrarse y jugar." Style="{StaticResource Muted}" Margin="0,0,0,18"/>

                    <Border Style="{StaticResource Card}" Padding="22">
                        <StackPanel>
                            <TextBox x:Name="TxtAdminName" Style="{StaticResource InputBox}" Height="38" Width="300" HorizontalAlignment="Left" MaxLength="16" Margin="0,0,0,10"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Button x:Name="BtnAdminAdd" Content="Añadir" Click="AdminAdd_Click" Style="{StaticResource PrimaryButton}" Width="92" Height="34" Margin="0,0,8,0"/>
                                <Button x:Name="BtnAdminEdit" Content="Editar" Click="AdminEdit_Click" Style="{StaticResource SecondaryButton}" Width="92" Height="34" Margin="0,0,8,0"/>
                                <Button x:Name="BtnAdminRemove" Content="Quitar" Click="AdminRemove_Click" Style="{StaticResource DangerButton}" Width="92" Height="34"/>
                            </StackPanel>

                            <ListBox x:Name="LstParticipants" Style="{StaticResource DarkList}" Height="140" Width="300" HorizontalAlignment="Left"
                                     SelectionChanged="LstParticipants_SelectionChanged"/>

                            <TextBlock x:Name="TxtAdminCount" Text="0 invitados" Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,12"/>

                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnAdminExport" Content="Exportar whitelist.json" Click="AdminExport_Click" Style="{StaticResource SuccessButton}" Width="180" Height="34" Margin="0,0,8,0"/>
                                <Button x:Name="BtnAdminLoad" Content="Cargar lista online" Click="AdminLoadRemote_Click" Style="{StaticResource SecondaryButton}" Width="170" Height="34"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- AJUSTES -->
            <ScrollViewer x:Name="ViewSettings" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock x:Name="LblSettingsTitle" Text="CONFIGURACIÓN" Style="{StaticResource Eyebrow}"/>
                    <TextBlock x:Name="LblSettingsHeader" Text="Ajustes del Launcher" Style="{StaticResource H1}" Margin="0,0,0,20"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="LblCardAppearance" Text="Apariencia" Style="{StaticResource CardTitle}"/>

                                <TextBlock x:Name="LblThemeLabel" Text="Tema Visual" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CbTheme" Style="{StaticResource DarkCombo}" Margin="0,0,0,14" SelectionChanged="CbTheme_SelectionChanged">
                                    <ComboBoxItem Content="Oscuro · Dark"/>
                                    <ComboBoxItem Content="Claro · Light"/>
                                </ComboBox>

                                <TextBlock x:Name="LblAccentLabel" Text="Color de acento" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CbAccent" Style="{StaticResource DarkCombo}" Margin="0,0,0,14" SelectionChanged="CbAccent_SelectionChanged">
                                    <ComboBoxItem Content="Violeta · Purple"/>
                                    <ComboBoxItem Content="Azul · Blue"/>
                                    <ComboBoxItem Content="Verde · Green"/>
                                    <ComboBoxItem Content="Rojo · Red"/>
                                    <ComboBoxItem Content="Naranja · Orange"/>
                                </ComboBox>

                                <TextBlock x:Name="LblLangLabel" Text="Idioma / Language" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CbLanguage" Style="{StaticResource DarkCombo}" SelectionChanged="CbLanguage_SelectionChanged">
                                    <ComboBoxItem Content="Español"/>
                                    <ComboBoxItem Content="English"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="LblCardGame" Text="Juego" Style="{StaticResource CardTitle}"/>

                                <TextBlock x:Name="LblRamLabel" Text="Memoria RAM para Minecraft" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CbRam" Style="{StaticResource DarkCombo}" Margin="0,0,0,18" SelectionChanged="CbRam_SelectionChanged">
                                    <ComboBoxItem Content="2 GB"/>
                                    <ComboBoxItem Content="3 GB"/>
                                    <ComboBoxItem Content="4 GB"/>
                                    <ComboBoxItem Content="6 GB"/>
                                    <ComboBoxItem Content="8 GB"/>
                                </ComboBox>

                                <CheckBox x:Name="ChkHideOnPlay" Style="{StaticResource SwitchBox}" Content="Ocultar el launcher mientras juegas"
                                          IsChecked="True" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                <CheckBox x:Name="ChkCheckUpdates" Style="{StaticResource SwitchBox}" Content="Buscar actualizaciones del modpack al jugar"
                                          IsChecked="True" Margin="0" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock x:Name="LblCardMaint" Text="Mantenimiento" Style="{StaticResource CardTitle}"/>
                            <WrapPanel>
                                <Button x:Name="BtnOpenFolder" Content="Abrir carpeta del juego" Click="OpenFolder_Click" Style="{StaticResource SecondaryButton}" Height="36" Margin="0,0,8,6"/>
                                <Button x:Name="BtnReinstall" Content="Reinstalar modpack" Click="Reinstall_Click" Style="{StaticResource SecondaryButton}" Height="36" Margin="0,0,8,6"/>
                                <Button x:Name="BtnOpenLog" Content="Abrir último log" Click="OpenLog_Click" Style="{StaticResource SecondaryButton}" Height="36" Margin="0,0,8,6"/>
                                <Button x:Name="BtnChangeUser" Content="Cambiar de usuario" Click="ChangeUser_Click" Style="{StaticResource DangerButton}" Height="36" Margin="0,0,0,6"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Grid>
</Window>
