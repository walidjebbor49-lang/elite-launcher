<Window x:Class="ELITE.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ELITE.Launcher"
        Title="ELITExtremun Launcher" Height="760" Width="1180"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        WindowStyle="None" FontFamily="Segoe UI"
        Background="{DynamicResource BgBrush}">

    <Window.Resources>

        <!-- ═════════ COLORES (el código los cambia para tema claro/oscuro y acento) ═════════ -->
        <Color x:Key="BgColor">#08060F</Color>
        <Color x:Key="SidebarColor">#0C0916</Color>
        <Color x:Key="CardColor">#130E22</Color>
        <Color x:Key="InputColor">#1A1230</Color>
        <Color x:Key="LineColor">#2A1D47</Color>
        <Color x:Key="TextColor">#F3EEFF</Color>
        <Color x:Key="MutedColor">#9088AD</Color>
        <Color x:Key="NavActiveColor">#22153F</Color>
        <Color x:Key="AccentColor">#9B5CFF</Color>
        <Color x:Key="AccentColor2">#6D28D9</Color>
        <Color x:Key="OnAccentColor">#FFFFFF</Color>

        <SolidColorBrush x:Key="BgBrush" Color="{DynamicResource BgColor}"/>
        <SolidColorBrush x:Key="SidebarBrush" Color="{DynamicResource SidebarColor}"/>
        <SolidColorBrush x:Key="CardBrush" Color="{DynamicResource CardColor}"/>
        <SolidColorBrush x:Key="InputBrush" Color="{DynamicResource InputColor}"/>
        <SolidColorBrush x:Key="LineBrush" Color="{DynamicResource LineColor}"/>
        <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}"/>
        <SolidColorBrush x:Key="MutedBrush" Color="{DynamicResource MutedColor}"/>
        <SolidColorBrush x:Key="NavActiveBrush" Color="{DynamicResource NavActiveColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}"/>
        <SolidColorBrush x:Key="OnAccentBrush" Color="{DynamicResource OnAccentColor}"/>
        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
            <GradientStop Color="{DynamicResource AccentColor2}" Offset="1"/>
        </LinearGradientBrush>

        <!-- ═════════ ICONOS DEL MENÚ (cuadrícula de 24x24) ═════════ -->
        <PathGeometry x:Key="IcoHome" Figures="M3,10.5 L12,3 L21,10.5 M5,9 V21 H10 V14 H14 V21 H19 V9"/>
        <GeometryGroup x:Key="IcoUser">
            <EllipseGeometry Center="12,8" RadiusX="4" RadiusY="4"/>
            <PathGeometry Figures="M4,21 V19 A4,4 0 0 1 8,15 H16 A4,4 0 0 1 20,19 V21"/>
        </GeometryGroup>
        <PathGeometry x:Key="IcoBolt" Figures="M13,2 L4,14 H11 L10,22 L20,9 H13 Z"/>
        <PathGeometry x:Key="IcoBox" Figures="M12,2 L21,7 V17 L12,22 L3,17 V7 Z M3,7 L12,12 L21,7 M12,12 V22"/>
        <PathGeometry x:Key="IcoSliders" Figures="M4,21 V14 M4,10 V3 M12,21 V12 M12,8 V3 M20,21 V16 M20,12 V3 M1,14 H7 M9,8 H15 M17,16 H23"/>
        <PathGeometry x:Key="IcoShield" Figures="M12,2 L20,5 V12 C20,17 16,20.5 12,22 C8,20.5 4,17 4,12 V5 Z"/>
        <PathGeometry x:Key="IcoLayers" Figures="M12,3 L21,8 L12,13 L3,8 Z M3,12 L12,17 L21,12 M3,16 L12,21 L21,16"/>
        <PathGeometry x:Key="IcoServer" Figures="M4,4 H20 V10 H4 Z M4,14 H20 V20 H4 Z M8,7 L8.1,7 M8,17 L8.1,17"/>
        <PathGeometry x:Key="IcoCalendar" Figures="M4,6 H20 V21 H4 Z M4,11 H20 M8,3 V8 M16,3 V8"/>
        <PathGeometry x:Key="IcoChat" Figures="M4,5 H20 V16 H11 L6,20 V16 H4 Z"/>
        <GeometryGroup x:Key="IcoInfo">
            <EllipseGeometry Center="12,12" RadiusX="9" RadiusY="9"/>
            <PathGeometry Figures="M12,11 V17 M12,7.5 L12,7.6"/>
        </GeometryGroup>

        <!-- ═════════ TEXTOS ═════════ -->
        <Style x:Key="Eyebrow" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="H1" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- ═════════ TARJETA ═════════ -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="22"/>
        </Style>

        <!-- ═════════ BARRA DE SCROLL FINA ═════════ -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="3" Margin="1" Background="{DynamicResource MutedBrush}" Opacity="0.35"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═════════ BOTONES ═════════ -->
        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{DynamicResource AccentGradient}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="#E5484D"/>
        </Style>
        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="#10B981"/>
        </Style>

        <!-- Botones de la ventana (minimizar / cerrar) -->
        <Style x:Key="WinButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavActiveBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WinCloseButton" TargetType="Button" BasedOn="{StaticResource WinButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E5484D"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón del menú lateral (Tag="Active" marca la página actual, local:NavIcon.Data el icono) -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"/>
                            <Border x:Name="Bar" Width="3" CornerRadius="2" Margin="0,8"
                                    Background="{DynamicResource AccentBrush}"
                                    HorizontalAlignment="Left" Visibility="Collapsed"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                <Viewbox Width="18" Height="18">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="{Binding Path=(local:NavIcon.Data), RelativeSource={RelativeSource TemplatedParent}}"
                                              Stroke="{TemplateBinding Foreground}" StrokeThickness="1.8"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Canvas>
                                </Viewbox>
                                <ContentPresenter Margin="14,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavActiveBrush}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavActiveBrush}"/>
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═════════ CAJA DE TEXTO ═════════ -->
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═════════ LISTA ═════════ -->
        <Style x:Key="DarkList" TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="4">
                            <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavActiveBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═════════ DESPLEGABLE ═════════ -->
        <Style x:Key="ComboToggle" TargetType="ToggleButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{DynamicResource InputBrush}"
                                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6">
                            <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"
                                  Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.6"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Style="{StaticResource ComboToggle}" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter IsHitTestVisible="False" Margin="14,0,34,0"
                                              VerticalAlignment="Center" HorizontalAlignment="Left"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                            <Popup Placement="Bottom" Focusable="False" AllowsTransparency="True"
                                   PopupAnimation="Fade" IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border MinWidth="{Binding Path=ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}"
                                        BorderThickness="1" CornerRadius="6" Margin="0,4,0,0" Padding="4">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavActiveBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═════════ SLIDER ═════════ -->
        <Style x:Key="AccentSlider" TargetType="Slider">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Border Height="6" CornerRadius="3" Background="{DynamicResource InputBrush}"
                                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6" CornerRadius="3" Background="{DynamicResource AccentGradient}"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="20" Height="20">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{DynamicResource TextBrush}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="3"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═════════ INTERRUPTOR (CheckBox) ═════════ -->
        <Style x:Key="SwitchBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="40" Height="22" VerticalAlignment="Center">
                                <Border x:Name="Track" CornerRadius="11" Background="{DynamicResource InputBrush}"
                                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"/>
                                <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="{DynamicResource MutedBrush}"
                                         HorizontalAlignment="Left" Margin="4,0,0,0"/>
                            </Grid>
                            <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,4,0"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource OnAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═════════ BARRA LATERAL ═════════ -->
            <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="0,0,1,0" Grid.Column="0">
                <DockPanel Margin="16,0,16,18">

                    <!-- Logo (también sirve para arrastrar la ventana) -->
                    <StackPanel Orientation="Horizontal" Margin="4,22,0,28" DockPanel.Dock="Top"
                                Background="Transparent" MouseLeftButtonDown="DragWindow">
                        <Viewbox Width="34" Height="34">
                            <Canvas Width="32" Height="32">
                                <Path Data="M16,2 L30,16 L16,30 L2,16 Z" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.4" StrokeLineJoin="Round"/>
                                <Path Data="M16,9 L23,16 L16,23 L9,16 Z" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.4" StrokeLineJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="LblBrandTitle" Text="ELIT" Foreground="{DynamicResource TextBrush}" FontWeight="Bold" FontSize="20"/>
                            <TextBlock x:Name="LblBrandSub" Text="EXTREMUN" Foreground="{DynamicResource MutedBrush}" FontSize="10" FontWeight="SemiBold" Margin="1,-2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock x:Name="LblMenuHeader" Text="MENÚ PRINCIPAL" Foreground="{DynamicResource MutedBrush}"
                               FontSize="10" FontWeight="Bold" Margin="8,0,0,10" DockPanel.Dock="Top"/>

                    <!-- Jugador registrado -->
                    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="4,16,0,0" DockPanel.Dock="Bottom">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="38" Height="38">
                                <Ellipse Fill="{DynamicResource InputBrush}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5"/>
                                <TextBlock x:Name="TxtSideInitial" Text="?" Foreground="{DynamicResource TextBrush}" FontWeight="Bold" FontSize="15"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="LblSidebarUserTag" Text="JUGADOR" Foreground="{DynamicResource MutedBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,1"/>
                                <TextBlock x:Name="TxtSidebarUser" Text="Sin registrar" Foreground="{DynamicResource TextBrush}" FontSize="14" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" MaxWidth="120"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel>
                        <Button x:Name="BtnNavRegister" Content="Perfil" Click="NavRegister_Click" Style="{StaticResource NavButton}" Tag="Active"
                                local:NavIcon.Data="{StaticResource IcoUser}"/>
                        <Button x:Name="BtnNavHome" Content="Eventos" Click="NavHome_Click" Style="{StaticResource NavButton}"
                                local:NavIcon.Data="{StaticResource IcoCalendar}"/>
                        <Button x:Name="BtnNavOpt" Content="Optimización" Click="Optimization_Click" Style="{StaticResource NavButton}"
                                local:NavIcon.Data="{StaticResource IcoBolt}"/>
                        <Button x:Name="BtnNavSettings" Content="Ajustes" Click="Settings_Click" Style="{StaticResource NavButton}"
                                local:NavIcon.Data="{StaticResource IcoSliders}"/>
                        <Button x:Name="BtnNavAbout" Content="Acerca de" Click="NavAbout_Click" Style="{StaticResource NavButton}"
                                local:NavIcon.Data="{StaticResource IcoInfo}"/>
                        <Button x:Name="BtnNavDiscord" Content="Discord" Click="NavDiscord_Click" Style="{StaticResource NavButton}"
                                local:NavIcon.Data="{StaticResource IcoChat}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ═════════ CONTENIDO ═════════ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Fondo con imagen + velo para que se lea el texto -->
                <Image Grid.RowSpan="2" Source="Assets/background.png" Stretch="UniformToFill" IsHitTestVisible="False"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <Border Grid.RowSpan="2" Background="{DynamicResource BgBrush}" Opacity="0.6" IsHitTestVisible="False"/>

                <!-- Barra superior: arrastrar + minimizar / cerrar -->
                <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="DragWindow">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource WinButton}" Click="BtnMin_Click" ToolTip="Minimizar">
                            <Path Data="M0,0.5 H10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2"/>
                        </Button>
                        <Button Style="{StaticResource WinCloseButton}" Click="BtnClose_Click" ToolTip="Cerrar">
                            <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2"/>
                        </Button>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1" Margin="40,4,40,32">

                    <!-- INICIO -->
                    <Grid x:Name="ViewHome" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- un resplandor suave detrás del nombre, nada más -->
                        <Border Grid.RowSpan="2" Opacity="0.13" IsHitTestVisible="False" Margin="-40,-10,-40,60">
                            <Border.Background>
                                <RadialGradientBrush Center="0.5,0.38" RadiusX="0.55" RadiusY="0.5" GradientOrigin="0.5,0.38">
                                    <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
                                    <GradientStop Color="Transparent" Offset="1"/>
                                </RadialGradientBrush>
                            </Border.Background>
                        </Border>

                        <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="LblWelcomeTag" Text="BIENVENIDO A" Foreground="{DynamicResource MutedBrush}"
                                       FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                            <TextBlock Text="ELIT" Foreground="{DynamicResource TextBrush}" FontSize="92" FontWeight="Bold"
                                       HorizontalAlignment="Center">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="34" ShadowDepth="0" Opacity="0.5"/>
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock Text="EXTREMUN" Foreground="{DynamicResource TextBrush}" FontSize="44" FontWeight="Light"
                                       HorizontalAlignment="Center" Margin="0,-26,0,0"/>
                            <TextBlock x:Name="LblWelcomeMain" Text="Tu Minecraft. A tu manera." Foreground="{DynamicResource TextBrush}"
                                       FontSize="15" HorizontalAlignment="Center" Margin="0,22,0,4"/>
                            <TextBlock x:Name="LblWelcomeDesc" Text="Pulsa JUGAR para entrar al servidor."
                                       Style="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Width="560" HorizontalAlignment="Center">

                            <!-- Anuncios del organizador (se leen de announcement.txt en el repo) -->
                            <Border x:Name="BdNews" Style="{StaticResource Card}" Padding="18,12" Margin="0,0,0,12" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock x:Name="LblNewsTitle" Text="Anuncios del evento" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="TxtNews" Text="" Foreground="{DynamicResource TextBrush}" FontSize="13" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Padding="18,12" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse x:Name="ElServerDot" Width="8" Height="8" Fill="#8B9BB4" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtServerStatus" Text="" Style="{StaticResource Muted}" FontSize="12" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtHomePlayer" Grid.Column="1" Text="" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Border x:Name="BdClosed" Style="{StaticResource Card}" Padding="18,12" Margin="0,0,0,12" BorderBrush="#E5484D" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock x:Name="LblClosedTitle" Text="EVENTO CERRADO" Foreground="#FF7675" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="TxtClosedMsg" Text="" Foreground="{DynamicResource TextBrush}" FontSize="13" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Button x:Name="BtnLaunch" Content="JUGAR ►" Click="BtnLaunch_Click"
                                    Style="{StaticResource PrimaryButton}" Height="52" FontSize="15">
                                <Button.Effect>
                                    <DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="24" ShadowDepth="0" Opacity="0.45"/>
                                </Button.Effect>
                            </Button>

                            <ProgressBar x:Name="PbLaunch" IsIndeterminate="True" Height="3" Visibility="Collapsed" BorderThickness="0"
                                         Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource InputBrush}" Margin="0,12,0,0"/>
                            <TextBlock x:Name="TxtStatus" Text="  Sistema listo" Foreground="#3DDC97" FontSize="12" FontWeight="SemiBold"
                                       TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- PERFIL / REGISTRO (obligatorio) -->
                    <StackPanel x:Name="ViewRegister" Visibility="Collapsed">
                        <TextBlock x:Name="LblRegTag" Text="REGISTRO OBLIGATORIO" Style="{StaticResource Eyebrow}"/>
                        <TextBlock x:Name="LblRegTitle" Text="Regístrate" Style="{StaticResource H1}"/>
                        <TextBlock x:Name="LblRegDesc" Text="Escribe el nombre de jugador con el que te invitaron al evento." Style="{StaticResource Muted}" Margin="0,0,0,22"/>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="84" Height="84">
                                    <Ellipse Fill="{DynamicResource InputBrush}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.5"/>
                                    <TextBlock x:Name="TxtAvatarInitial" Text="?" Foreground="{DynamicResource TextBrush}" FontWeight="Bold" FontSize="34"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <StackPanel Margin="22,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtProfileName" Text="Sin registrar" Foreground="{DynamicResource TextBrush}" FontSize="28" FontWeight="Bold"/>
                                    <Border x:Name="BdVerified" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,8,0,0"
                                            BorderBrush="#3DDC97" BorderThickness="1" CornerRadius="12" Padding="10,3">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M0,4 L3.5,7.5 L10,0.5" Stroke="#3DDC97" StrokeThickness="1.8" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtVerified" Text="Cuenta verificada" Foreground="#3DDC97" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock x:Name="TxtRegCurrent" Text="Sin registrar" Visibility="Collapsed"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock x:Name="LblRegName" Text="Nombre de jugador" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtRegName" Style="{StaticResource InputBox}" Height="40" Width="320" HorizontalAlignment="Left"
                                         MaxLength="16" Margin="0,0,0,18" PreviewKeyDown="TxtRegName_KeyDown"/>
                                <Button x:Name="BtnRegister" Content="REGISTRARME" Click="BtnRegister_Click"
                                        Style="{StaticResource PrimaryButton}" Width="190" Height="42" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="TxtRegStatus" Text="" Foreground="{DynamicResource MutedBrush}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="4,0,0,0"/>
                    </StackPanel>

                    <!-- PANEL DE ADMINISTRADOR -->
                    <ScrollViewer x:Name="ViewAdmin" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock x:Name="LblAdminTag" Text="PANEL DE ADMINISTRADOR" Style="{StaticResource Eyebrow}"/>
                            <TextBlock x:Name="LblAdminTitle" Text="Participantes invitados" Style="{StaticResource H1}"/>
                            <TextBlock x:Name="LblAdminDesc" Text="Solo los nombres de esta lista podrán registrarse y jugar." Style="{StaticResource Muted}" Margin="0,0,0,18"/>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock x:Name="LblEventTitle" Text="Acceso al evento" Style="{StaticResource CardTitle}" Margin="0,0,0,12"/>
                                    <CheckBox x:Name="ChkEventOpen" Style="{StaticResource SwitchBox}" Content="Los jugadores pueden entrar"
                                              IsChecked="True" Checked="EventSetting_Changed" Unchecked="EventSetting_Changed"/>
                                    <TextBlock x:Name="LblEventMsg" Text="Mensaje cuando esté cerrado" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="TxtEventMessage" Style="{StaticResource InputBox}" Height="38" Width="420" HorizontalAlignment="Left"
                                             MaxLength="120" Margin="0,0,0,12" TextChanged="TxtEventMessage_TextChanged"/>
                                    <Button x:Name="BtnEventExport" Content="Exportar event.json" Click="EventExport_Click"
                                            Style="{StaticResource SuccessButton}" Width="190" Height="34" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="LblEventHint" Text="" Style="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBox x:Name="TxtAdminName" Style="{StaticResource InputBox}" Height="38" Width="320" HorizontalAlignment="Left" MaxLength="16" Margin="0,0,0,10"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Button x:Name="BtnAdminAdd" Content="Añadir" Click="AdminAdd_Click" Style="{StaticResource PrimaryButton}" Width="96" Height="34" Margin="0,0,8,0"/>
                                        <Button x:Name="BtnAdminEdit" Content="Editar" Click="AdminEdit_Click" Style="{StaticResource SecondaryButton}" Width="96" Height="34" Margin="0,0,8,0"/>
                                        <Button x:Name="BtnAdminRemove" Content="Quitar" Click="AdminRemove_Click" Style="{StaticResource DangerButton}" Width="96" Height="34"/>
                                    </StackPanel>

                                    <ListBox x:Name="LstParticipants" Style="{StaticResource DarkList}" Height="140" Width="320" HorizontalAlignment="Left"
                                             SelectionChanged="LstParticipants_SelectionChanged"/>

                                    <TextBlock x:Name="TxtAdminCount" Text="0 invitados" Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,12"/>

                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="BtnAdminExport" Content="Exportar whitelist.json" Click="AdminExport_Click" Style="{StaticResource SuccessButton}" Width="190" Height="34" Margin="0,0,8,0"/>
                                        <Button x:Name="BtnAdminLoad" Content="Cargar lista online" Click="AdminLoadRemote_Click" Style="{StaticResource SecondaryButton}" Width="170" Height="34"/>
                                    </StackPanel>

                                    <Button x:Name="BtnAdminFree" Content="Liberar nombre registrado" Click="AdminFree_Click" Style="{StaticResource DangerButton}" Width="368" Height="34" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ACERCA DE -->
                    <ScrollViewer x:Name="ViewAbout" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock x:Name="LblAboutTag" Text="ACERCA DE" Style="{StaticResource Eyebrow}"/>
                            <TextBlock Text="ELITExtremun Launcher" Style="{StaticResource H1}"/>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock x:Name="LblAboutDesc" Text="" Style="{StaticResource Muted}" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,14"/>
                                    <TextBlock x:Name="LblAboutDev" Text="" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="LblAboutCredits" Text="" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="LblAboutLegal" Text="" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,16"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- AJUSTES -->
                    <ScrollViewer x:Name="ViewSettings" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock x:Name="LblSettingsTitle" Text="CONFIGURACIÓN" Style="{StaticResource Eyebrow}"/>
                            <TextBlock x:Name="LblSettingsHeader" Text="Ajustes del Launcher" Style="{StaticResource H1}" Margin="0,0,0,18"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock x:Name="LblCardAppearance" Text="Apariencia" Style="{StaticResource CardTitle}"/>

                                        <TextBlock x:Name="LblThemeLabel" Text="Tema Visual" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="CbTheme" Style="{StaticResource DarkCombo}" Margin="0,0,0,14" SelectionChanged="CbTheme_SelectionChanged">
                                            <ComboBoxItem Content="Oscuro · Dark"/>
                                            <ComboBoxItem Content="Claro · Light"/>
                                        </ComboBox>

                                        <TextBlock x:Name="LblAccentLabel" Text="Color de acento" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="CbAccent" Style="{StaticResource DarkCombo}" Margin="0,0,0,14" SelectionChanged="CbAccent_SelectionChanged">
                                            <ComboBoxItem Content="Violeta · Purple"/>
                                            <ComboBoxItem Content="Cian · Cyan"/>
                                            <ComboBoxItem Content="Verde · Green"/>
                                            <ComboBoxItem Content="Rojo · Red"/>
                                            <ComboBoxItem Content="Naranja · Orange"/>
                                        </ComboBox>

                                        <TextBlock x:Name="LblLangLabel" Text="Idioma / Language" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="CbLanguage" Style="{StaticResource DarkCombo}" SelectionChanged="CbLanguage_SelectionChanged">
                                            <ComboBoxItem Content="Español"/>
                                            <ComboBoxItem Content="English"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock x:Name="LblCardGame" Text="Juego" Style="{StaticResource CardTitle}"/>

                                        <TextBlock x:Name="LblRamLabel" Text="Memoria RAM para Minecraft" Style="{StaticResource FieldLabel}"/>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="SlRam" Style="{StaticResource AccentSlider}" VerticalAlignment="Center"
                                                    Minimum="2" Maximum="16" Value="3" TickFrequency="1" IsSnapToTickEnabled="True"
                                                    ValueChanged="SlRam_ValueChanged"/>
                                            <TextBlock x:Name="TxtRamValue" Grid.Column="1" Text="3 GB" Foreground="{DynamicResource AccentBrush}"
                                                       FontWeight="Bold" FontSize="14" Width="56" TextAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                        <TextBlock x:Name="LblRamHint" Text="" Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,18"/>

                                        <CheckBox x:Name="ChkHideOnPlay" Style="{StaticResource SwitchBox}" Content="Ocultar el launcher mientras juegas"
                                                  IsChecked="True" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                        <CheckBox x:Name="ChkCheckUpdates" Style="{StaticResource SwitchBox}" Content="Buscar actualizaciones al jugar"
                                                  IsChecked="True" Margin="0" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="LblCardMaint" Text="Mantenimiento" Style="{StaticResource CardTitle}"/>
                                    <WrapPanel>
                                        <Button x:Name="BtnReinstall" Content="Reparar instalación" Click="Reinstall_Click" Style="{StaticResource SecondaryButton}" Height="36" Margin="0,0,8,6"/>
                                        <Button x:Name="BtnChangeUser" Content="Cambiar de usuario" Click="ChangeUser_Click" Style="{StaticResource DangerButton}" Height="36" Margin="0,0,0,6"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                </Grid>

                <!-- Admin: esquina inferior derecha -->
                <Button x:Name="BtnNavAdmin" Grid.RowSpan="2" Style="{StaticResource WinButton}" Click="NavAdmin_Click" ToolTip="Admin"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,8" Width="34" Height="34" Opacity="0.55">
                    <Viewbox Width="16" Height="16">
                        <Canvas Width="24" Height="24">
                            <Path Data="{StaticResource IcoShield}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.8" StrokeLineJoin="Round"/>
                        </Canvas>
                    </Viewbox>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
