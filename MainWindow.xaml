<Window x:Class="ELITE.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ELITE Launcher" Height="720" Width="1180" MinHeight="640" MinWidth="980"
        WindowStartupLocation="CenterScreen" Background="#0B0D14" Foreground="#F4F5FA">
    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="#AEB4C7"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="16,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,3"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#20263A"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#8065FF"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/><Setter Property="FontSize" Value="16"/><Setter Property="Padding" Value="28,15"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#957FFF"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger></Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#10141F" Padding="18">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="8,12,0,34">
                        <Border Width="38" Height="38" CornerRadius="11" Background="#8065FF"><TextBlock Text="E" FontSize="25" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center"><TextBlock Text="ELITE" FontSize="20" FontWeight="ExtraBold"/><TextBlock Text="MINECRAFT LAUNCHER" FontSize="8" Foreground="#9299AE" CharacterSpacing="120"/></StackPanel>
                    </StackPanel>
                    <TextBlock Text="MENÚ PRINCIPAL" Foreground="#626B82" FontSize="10" FontWeight="Bold" Margin="12,0,0,10"/>
                    <Button Style="{StaticResource NavButton}" Content="⌂    Inicio" Background="#20263A" Foreground="White"/>
                    <Button Style="{StaticResource NavButton}" Content="▤    Versiones" Click="Versions_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="✧    Optimización" Click="Optimization_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="▦    Mods" Click="Mods_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="⚙    Ajustes" Click="Settings_Click"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="8,0,0,8">
                    <TextBlock Text="CUENTA" Foreground="#626B82" FontSize="10" FontWeight="Bold" Margin="4,0,0,12"/>
                    <TextBlock Text="Modo sin conexión" Foreground="#AEB4C7" FontSize="12"/>
                    <TextBlock Text="ELITE 0.1.0 • PREVIEW" Foreground="#626B82" FontSize="10" Margin="0,14,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="38,30,38,34">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,30"><StackPanel><TextBlock Text="BIENVENIDO A ELITE" Foreground="#A99AFF" FontSize="11" FontWeight="Bold"/><TextBlock Text="Tu Minecraft. A tu manera." FontSize="30" FontWeight="Bold" Margin="0,7,0,0"/><TextBlock Text="Rendimiento, personalización y control en un solo lugar." Foreground="#9299AE" FontSize="14" Margin="0,7,0,0"/></StackPanel><Border HorizontalAlignment="Right" Background="#171D2B" CornerRadius="20" Padding="13,8" VerticalAlignment="Top"><TextBlock Text="●  SISTEMA LISTO" Foreground="#7ED6A2" FontSize="10" FontWeight="Bold"/></Border></Grid>
                <Border Grid.Row="1" CornerRadius="20" Padding="30" Margin="0,0,0,22" Background="#171B2B">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center"><TextBlock Text="TU PRÓXIMA AVENTURA" Foreground="#B5A9FF" FontSize="10" FontWeight="Bold"/><TextBlock Text="Minecraft Java Edition" FontSize="25" FontWeight="Bold" Margin="0,9,0,5"/><TextBlock Text="Selecciona una versión para preparar tu partida." Foreground="#A5ABC0" FontSize="13"/><StackPanel Orientation="Horizontal" Margin="0,22,0,0"><Button Style="{StaticResource ActionButton}" Content="JUGAR  ▶" IsEnabled="False"/><TextBlock Text="  Motor en desarrollo" Foreground="#9299AE" VerticalAlignment="Center" FontSize="11"/></StackPanel></StackPanel>
                        <Border Grid.Column="1" Background="#22203C" CornerRadius="16"><Grid><TextBlock Text="ELITE" FontSize="42" FontWeight="Black" Foreground="#B8ACFF" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBlock Text="PERFORMANCE CLIENT" FontSize="8" Foreground="#A99AFF" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,23"/></Grid></Border>
                    </Grid>
                </Border>
                <TextBlock Grid.Row="2" Text="ACCESO RÁPIDO" FontSize="12" FontWeight="Bold" Margin="0,4,0,13"/>
                <UniformGrid Grid.Row="3" Columns="2" Rows="2">
                    <Border Background="#141824" CornerRadius="15" Padding="20" Margin="0,0,10,10"><StackPanel><TextBlock Text="▤  Versiones" FontSize="16" FontWeight="Bold"/><TextBlock Text="Gestiona versiones oficiales, Fabric y Forge." Foreground="#9299AE" TextWrapping="Wrap" Margin="0,9,0,0"/></StackPanel></Border>
                    <Border Background="#141824" CornerRadius="15" Padding="20" Margin="10,0,0,10"><StackPanel><TextBlock Text="✧  Rendimiento" FontSize="16" FontWeight="Bold"/><TextBlock Text="Prepara perfiles para priorizar FPS o calidad." Foreground="#9299AE" TextWrapping="Wrap" Margin="0,9,0,0"/></StackPanel></Border>
                    <Border Background="#141824" CornerRadius="15" Padding="20" Margin="0,10,10,0"><StackPanel><TextBlock Text="▦  Biblioteca de mods" FontSize="16" FontWeight="Bold"/><TextBlock Text="Organiza tus mods por instalación." Foreground="#9299AE" TextWrapping="Wrap" Margin="0,9,0,0"/></StackPanel></Border>
                    <Border Background="#141824" CornerRadius="15" Padding="20" Margin="10,10,0,0"><StackPanel><TextBlock Text="⚙  Configuración" FontSize="16" FontWeight="Bold"/><TextBlock Text="Memoria, resolución y opciones del launcher." Foreground="#9299AE" TextWrapping="Wrap" Margin="0,9,0,0"/></StackPanel></Border>
                </UniformGrid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
