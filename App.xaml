<Application x:Class="ELITE.Launcher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#0B0D14" />
        <SolidColorBrush x:Key="PanelBrush" Color="#141824" />
        <SolidColorBrush x:Key="AccentBrush" Color="#8065FF" />
        <SolidColorBrush x:Key="MutedBrush" Color="#9299AE" />
    </Application.Resources>
</Application>
